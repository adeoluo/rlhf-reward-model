flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        CLI["CLI<br/>evaluate, methods, ..."]:::edge
        Client(["HTTP client"]):::edge
        Router["HTTP router<br/>/report /score"]:::core
        Validate["Validation<br/>prompt in range"]:::control
        CLI ~~~ Client --> Router --> Validate
    end

    subgraph Task["Alignment task"]
        direction TB
        Gold[("Gold reward<br/>hidden from learner")]:::data
        Demos[("Demonstrations<br/>weak teacher")]:::data
        Prefs[("Preference pairs<br/>Bradley-Terry")]:::data
        Gold --> Demos
        Gold --> Prefs
    end

    subgraph Methods["Post-training methods"]
        direction TB
        SFT["SFT<br/>behavior cloning"]:::core
        RM["Reward model<br/>Bradley-Terry fit"]:::core
        PPO["PPO<br/>clipped, KL-shaped"]:::core
        DPO["DPO<br/>no reward model"]:::core
        Policies[("Trained policies<br/>reference, PPO, DPO")]:::data
        DPO ~~~ SFT ~~~ RM --> PPO --> Policies
    end

    subgraph Obs["Evaluation and studies"]
        direction TB
        Report["RLHF report<br/>RM fidelity, reward, KL"]:::obs
        Compare["PPO vs DPO<br/>quality, data efficiency"]:::obs
        Overopt["Over-optimization<br/>proxy vs true reward"]:::obs
        Score["Score response<br/>rewards, probabilities"]:::obs
        Metrics["Route metrics<br/>Prometheus text"]:::obs
        Report ~~~ Compare ~~~ Overopt ~~~ Score ~~~ Metrics
    end

    Interfaces -->|train, query| Methods
    Task -->|demos, preferences| Methods
    Methods -->|trained models| Obs
