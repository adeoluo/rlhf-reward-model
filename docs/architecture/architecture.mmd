---
title: System Architecture - RLHF Reward Model
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Task["Alignment task (hidden gold reward)"]
        direction TB
        Reward[(Gold reward weight)]:::data
        Demos[(Demonstrations)]:::data
        Prefs[(Preferences<br/>Bradley-Terry annotator)]:::data
    end

    subgraph Train["Three-stage RLHF (once at startup)"]
        direction TB
        SFT["Supervised fine-tuning<br/>behavior cloning"]:::core
        RM["Reward model<br/>Bradley-Terry logistic regression"]:::core
        PPO["PPO<br/>clipped surrogate, KL penalty"]:::core
    end

    Reference[(Reference policy)]:::data
    RewardModel[(Reward model)]:::data
    Policy[(PPO policy)]:::data

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /metrics | /report | /score"]:::core
        Validate["Validation<br/>prompt in range"]:::control
    end

    Eval["Evaluation<br/>reward-model fidelity, true reward, KL, over-optimization"]:::obs

    Reward --> Demos --> SFT --> Reference
    Reward --> Prefs --> RM --> RewardModel
    Reference --> PPO
    RewardModel --> PPO --> Policy
    RewardModel -.-> Eval
    Policy --> Eval
    Client -->|JSON request| Router --> Validate
    Validate -->|prompt| Policy
    Policy -->|rewards and distributions| Router -->|JSON response| Client
